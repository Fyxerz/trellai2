# Copia este fichero como .env (en cada ordenador) y rellena lo que uses.

# Tablero compartido entre tus ordenadores (Supabase → Connect → "Session pooler", URI).
# Sustituye [YOUR-PASSWORD] por la contraseña de la base de datos del proyecto.
# Usamos el proyecto «Despidator» con su usuario propio trellai_sync: solo ve el esquema trellai,
# no las tablas de las otras apps. Pide la contraseña a Pedro (está en su .env).
# TRELLAI_DATABASE_URL=postgresql://trellai_sync.uvhhjluakmocxujxvjqh:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Si cambias a otra base de datos, Trellai sube allí todo el tablero al arrancar.

# Nombre de este ordenador en el tablero (por defecto, el hostname).
# TRELLAI_MACHINE=mac-casa

# 0 = no subir las ramas trellai/* a GitHub (entonces otro ordenador no puede seguir una tarjeta empezada aquí).
# TRELLAI_PUSH_BRANCHES=1
